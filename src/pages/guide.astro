---
import Layout from '../layouts/Layout.astro'
import exchangeConfig from '../data/exchange-config.json'
import { formatPrice, getPoolValue, getSpotPrice } from '../utils/exchangeMath'
import '../styles/Theme.css'

const spotPrice = getSpotPrice(exchangeConfig.pool)
---

<Layout
  title="How SBC Exchange Works | SBC"
  description="Learn about SBC pricing, price impact and treasury payments."
>
  <section class="guide-shell min-h-screen text-white">
    <div class="safe-x safe-bottom mx-auto max-w-4xl pt-[calc(2rem+env(safe-area-inset-top))]">
      <div class="guide-stack space-y-4">
        <header class="guide-card guide-hero px-5 py-5 sm:px-6">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-[11px] uppercase tracking-[0.38em] text-cyan-200/55">Guide</p>
              <h1 class="mt-2 max-w-2xl text-3xl font-semibold text-white sm:text-4xl">How SBC Exchange works</h1>
              <p class="mt-3 max-w-xl text-sm leading-7 text-slate-400">Pool prices and treasury payments explained.</p>
            </div>
            <a href="/" class="guide-link w-full sm:w-auto">Home</a>
          </div>
        </header>

        <div class="grid gap-4 sm:grid-cols-3">
          <div class="guide-card guide-stat px-4 py-4">
            <p class="guide-label">Base price</p>
            <p data-pool-value="price" class="mt-2 text-2xl font-semibold text-white">{formatPrice(spotPrice, 6)}</p>
          </div>
          <div class="guide-card guide-stat px-4 py-4">
            <p class="guide-label">Pool value</p>
            <p data-pool-value="value" class="mt-2 text-2xl font-semibold text-white">{formatPrice(getPoolValue(exchangeConfig.pool), 2)}</p>
          </div>
          <div class="guide-card guide-stat px-4 py-4">
            <p class="guide-label">SBC total</p>
            <p data-pool-value="sbc" class="mt-2 text-2xl font-semibold text-white">{exchangeConfig.pool.sbc}</p>
          </div>
        </div>

        <article class="guide-card px-5 py-5 sm:px-6">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="guide-label">Workflow</p>
              <h2 class="mt-2 text-2xl font-semibold text-white">How it works</h2>
            </div>
            <div class="guide-badge">Live</div>
          </div>

          <div class="mt-5 grid gap-3">
            <div class="guide-row">
              <span class="guide-step">01</span>
              <p>Spot price = USDT reserve / SBC reserve.</p>
            </div>
            <div class="guide-row">
              <span class="guide-step">02</span>
              <p>Buying sends USDT to the treasury.</p>
            </div>
            <div class="guide-row">
              <span class="guide-step">03</span>
              <p>Selling sends SBC to the treasury.</p>
            </div>
            <div class="guide-row">
              <span class="guide-step">04</span>
              <p>Quotes use the current pool reserves.</p>
            </div>
          </div>
        </article>

        <div class="grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
          <section class="guide-card px-5 py-5 sm:px-6">
            <p class="guide-label">Formula</p>
            <h2 class="mt-2 text-2xl font-semibold text-white">Constant product</h2>
            <div class="guide-formula mt-5">k = reserve_SBC x reserve_USDT</div>
            <p class="mt-4 text-sm leading-7 text-slate-400">Larger trades have more price impact.</p>
          </section>

          <section class="guide-card px-5 py-5 sm:px-6">
            <p class="guide-label">Treasury</p>
            <h2 class="mt-2 text-2xl font-semibold text-white">Default values</h2>
            <div class="mt-5 space-y-3 text-sm text-slate-300">
              <p>USDT reserve: <span data-pool-value="usdt">{exchangeConfig.pool.usdt}</span></p>
              <p>SBC total: <span data-pool-value="sbc">{exchangeConfig.pool.sbc}</span></p>
              <p class="break-all text-slate-400">{exchangeConfig.treasuryWallet}</p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <style>
    .guide-shell {
      background:
        radial-gradient(circle at top, rgba(34, 211, 238, 0.14), transparent 32%),
        linear-gradient(180deg, #04111b 0%, #071521 100%);
    }

    .guide-stack > * {
      animation: guide-fade-up 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .guide-stack > *:nth-child(2) {
      animation-delay: 80ms;
    }

    .guide-stack > *:nth-child(3) {
      animation-delay: 140ms;
    }

    .guide-stack > *:nth-child(4) {
      animation-delay: 200ms;
    }

    .guide-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.03));
      backdrop-filter: blur(18px);
      box-shadow: 0 24px 80px rgba(2, 12, 27, 0.28);
      transition: transform 240ms ease, border-color 240ms ease, background 240ms ease;
    }

    .guide-card::before {
      content: '';
      position: absolute;
      inset: 0 auto auto 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, rgba(34, 211, 238, 0), rgba(34, 211, 238, 0.55), rgba(34, 211, 238, 0));
      opacity: 0.65;
      transform: translateX(-100%);
      animation: guide-scan 6s linear infinite;
    }

    .guide-card:hover {
      transform: translateY(-2px);
      border-color: rgba(103, 232, 249, 0.22);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.035));
    }

    .guide-hero {
      background:
        radial-gradient(circle at right top, rgba(34, 211, 238, 0.14), transparent 30%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.03));
    }

    .guide-label {
      font-size: 11px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      color: rgba(165, 243, 252, 0.58);
    }

    .guide-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 14px;
      padding: 0.8rem 1rem;
      font-size: 0.875rem;
      font-weight: 500;
      color: rgb(226 232 240);
      transition: border-color 180ms ease, transform 180ms ease, color 180ms ease;
    }

    .guide-link:hover {
      color: white;
      border-color: rgba(103, 232, 249, 0.35);
      transform: translateY(-1px);
    }

    .guide-badge {
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 12px;
      padding: 0.45rem 0.7rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: rgb(167 243 208);
      background: rgba(16, 185, 129, 0.1);
    }

    .guide-row {
      display: grid;
      grid-template-columns: 56px 1fr;
      gap: 1rem;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      background: rgba(9, 20, 31, 0.66);
      padding: 0.9rem 1rem;
      color: rgb(203 213 225);
      transition: border-color 180ms ease, transform 180ms ease;
    }

    .guide-row:hover {
      transform: translateX(2px);
      border-color: rgba(103, 232, 249, 0.18);
    }

    .guide-step {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      border: 1px solid rgba(34, 211, 238, 0.18);
      border-radius: 12px;
      background: rgba(34, 211, 238, 0.08);
      font-size: 0.75rem;
      font-weight: 600;
      color: rgb(165 243 252);
    }

    .guide-formula {
      border: 1px solid rgba(34, 211, 238, 0.15);
      border-radius: 14px;
      background: rgba(34, 211, 238, 0.08);
      padding: 1rem;
      color: rgb(207 250 254);
      font-size: 0.95rem;
      line-height: 1.8;
    }

    @keyframes guide-fade-up {
      from {
        opacity: 0;
        transform: translateY(18px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes guide-scan {
      from {
        transform: translateX(-100%);
      }

      to {
        transform: translateX(100%);
      }
    }
  </style>
</Layout>
